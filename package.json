{
  "name": "cloudnest",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@cloudnest/web",
    "dev:api": "npm run dev --workspace=@cloudnest/api",
    "dev:worker": "npm run dev --workspace=@cloudnest/telegram-worker",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "setup": "node scripts/dev-stack.mjs setup",
    "dev:stack": "node scripts/dev-stack.mjs up",
    "dev:stack:web": "node scripts/dev-stack.mjs up --web",
    "db:migrate": "node scripts/migrate.mjs",
    "test:server": "node --import tsx --test test/*.test.ts",
    "test:postgres": "node --import tsx --test apps/api/test/postgres.test.ts",
    "test:server-ui": "playwright test --config=playwright.server.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
