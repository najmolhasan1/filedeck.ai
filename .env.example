# Configuration reference. node scripts/dev-stack.mjs setup generates a private
# .env with random local secrets. It never supplies Telegram credentials.
# Do not commit .env or print its values. Plain API/worker commands require
# exported environment variables; the dev-stack/migration scripts load .env.

# Browser: choose demo (default browser IndexedDB) or server at BUILD time.
NEXT_PUBLIC_STORAGE_MODE=demo
# Origin/base only: the Next.js rewrite appends /v1 itself. Never append /v1 here.
API_URL=http://127.0.0.1:4000
APP_ORIGIN=http://localhost:3000
WEB_PORT=3000

# Real API mode (fail closed unless explicitly enabled + database configured).
CLOUDNEST_DEMO=0
CLOUDNEST_API_ENABLE=false
API_PORT=4000
API_HOST=127.0.0.1
CLOUDNEST_DATA_DIR=.data/api
STAGING_ROOT=
DATABASE_URL=
# Optional separate pool; give it the same restricted runtime role, never admin.
AUTH_DATABASE_URL=
# Required migration-owner connection; never supply this to the HTTP API.
DATABASE_ADMIN_URL=
CLOUDNEST_COOKIE_SECRET=

# Local Docker dependencies. The setup script generates unique 64-hex secrets.
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_APP_USER=cloudnest_app
POSTGRES_PORT=5432
REDIS_PORT=6379
# Redis is provisioned for future dispatch; current durable dispatch polls PG.
REDIS_URL=redis://127.0.0.1:6379

# Local Docker identity/directories. Setup fills absolute host paths and uid/gid.
CLOUDNEST_UID=
CLOUDNEST_GID=
CLOUDNEST_STAGING_HOST_DIR=
CLOUDNEST_SESSION_HOST_DIR=
# Optional public proxy CA PEM path for BuildKit; setup selects inherited CA.
CLOUDNEST_BUILD_CA_FILE=

# Internal authenticated worker RPC; keep private, never expose to browsers.
TELEGRAM_WORKER_URL=http://127.0.0.1:4001
CLOUDNEST_WORKER_TOKEN=
WORKER_HOST=127.0.0.1
WORKER_PORT=4001
CLOUDNEST_WORKER_ENABLE=false
# Only set true after operator verifies an encrypted mount and access controls.
# This acknowledgement does not implement KMS or prove encrypted storage.
CLOUDNEST_SESSION_STORAGE_APPROVED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TDLIB_DATABASE_KEY=
TDLIB_STATE_DIR=
TDLIB_USE_TEST_DC=false

# Separate developer-only interactive M0 harness; never customer accounts.
CLOUDNEST_SPIKE_ENABLE=false
CLOUDNEST_SPIKE_ACCOUNT=isolated-test-account
