{
  "openapi": "3.1.0",
  "info": {
    "title": "CloudNest server API and local demo",
    "version": "0.2.0",
    "description": "Server mode requires restricted PostgreSQL credentials, private worker RPC, cookie secret and account-scoped staging. Application identity is provider-verified; session cookies are HttpOnly. Demo data remains separate. Missing provider configuration fails clearly; no live Telegram acceptance is claimed."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4000/v1"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and explicit local-demo/not-configured status",
        "responses": {
          "200": {
            "description": "Successful operation."
          },
          "default": {
            "description": "Stable error object; live provider and production authentication are not configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/auth/telegram/start": {
      "post": {
        "summary": "Begin provider login after disclosure acceptance",
        "responses": {
          "200": {
            "description": "Requested provider authorization state."
          },
          "default": {
            "description": "Stable error with request_id and retry delay when applicable."
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "From auth/bootstrap or auth/refresh."
          }
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phoneNumber": {
                    "type": "string"
                  },
                  "disclosureAccepted": {
                    "type": "boolean",
                    "const": true
                  }
                },
                "required": [
                  "phoneNumber",
                  "disclosureAccepted"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/auth/telegram/step": {
      "post": {
        "summary": "Submit only the code/password requested by Telegram",
        "responses": {
          "200": {
            "description": "Requested provider authorization state."
          },
          "default": {
            "description": "Stable error with request_id and retry delay when applicable."
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "From auth/bootstrap or auth/refresh."
          }
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "step": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "code",
                          "password"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "maxLength": 512
                      }
                    },
                    "required": [
                      "type",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "step"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/auth/telegram/state": {
      "get": {
        "summary": "Poll current provider authorization state",
        "responses": {
          "200": {
            "description": "Requested provider authorization state."
          },
          "default": {
            "description": "Stable error with request_id and retry delay when applicable."
          }
        },
        "security": []
      }
    },
